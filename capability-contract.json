{
  "schemaVersion": 1,
  "minimum": {
    "sillytavern": "1.18.0",
    "tavernHelper": null
  },
  "requirements": [
    {
      "id": "host-context",
      "owner": "sillytavern",
      "symbol": "SillyTavern.getContext",
      "required": true,
      "fallback": null
    },
    {
      "id": "yuzuki-phone-runtime",
      "owner": "provider",
      "symbol": "window.VirtualPhone",
      "required": true,
      "fallback": null
    },
    {
      "id": "yuzuki-phone-page-shell",
      "owner": "provider",
      "symbol": "window.VirtualPhone.home.phoneShell.setContent",
      "required": true,
      "fallback": null
    },
    {
      "id": "yuzuki-phone-ai",
      "owner": "provider",
      "symbol": "window.VirtualPhone.apiManager.callAI",
      "required": true,
      "fallback": null
    },
    {
      "id": "yuzuki-phone-wechat-wallet",
      "owner": "provider",
      "symbol": "window.VirtualPhone.cachedWechatData.getWalletBalance/setWalletBalance",
      "required": false,
      "fallback": "通过柚月手机 extensionBaseUrl 按需加载同版本 WechatData；不可用时仅禁用余额工具。"
    },
    {
      "id": "yuzuki-memory-runtime",
      "owner": "provider",
      "symbol": "window.YuzukiMemory",
      "required": true,
      "fallback": null
    },
    {
      "id": "yuzuki-memory-storage",
      "owner": "provider",
      "symbol": "window.YuzukiMemory.Storage.loadState",
      "required": true,
      "fallback": null
    },
    {
      "id": "yuzuki-memory-summary",
      "owner": "provider",
      "symbol": "window.YuzukiMemory.VariableInjector.buildSummaryText",
      "required": false,
      "fallback": "从记忆插件现有表格生成只读文本快照。"
    }
  ]
}
